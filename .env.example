# Optional write/admin control. If absent, write endpoints fail closed.
AMX_ADMIN_TOKEN=replace-with-runtime-secret

# Optional comma-separated browser origins. Same-origin House needs no CORS entry.
AMX_CORS_ORIGINS=

# Optional overrides. Defaults shown.
AMX_DB_PATH=/app/data/amx_evidence.db
AMX_REPO_ROOT=/app

# CARBON° intent-marketplace state. Writes remain disabled by default.
CARBON_MARKETPLACE_DB_PATH=/app/data/carbon_marketplace.db
CARBON_MARKETPLACE_DEMO_MODE=0

# Optional live durable-state adapter. Without these, backend truthfully reports LOCAL_SNAPSHOT.
AMX_GITHUB_REPO=amillimatrix-eng/CARBON-Creation-Hub
AMX_GITHUB_REF=main
AMX_GITHUB_TOKEN=replace-with-read-token-at-runtime
