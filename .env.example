# Optional write/admin control. If absent, write endpoints fail closed.
AMX_ADMIN_TOKEN=replace-with-runtime-secret

# Optional comma-separated browser origins. Same-origin House needs no CORS entry.
AMX_CORS_ORIGINS=

# Optional overrides. Defaults shown.
AMX_DB_PATH=/app/data/amx_evidence.db
AMX_REPO_ROOT=/app

# CARBON° intent-marketplace state. Writes remain disabled by default.
CARBON_MARKETPLACE_DB_PATH=/app/data/carbon_marketplace.db
CARBON_MARKETPLACE_DEMO_MODE=0

# Optional live durable-state adapter. Without these, backend truthfully reports LOCAL_SNAPSHOT.
AMX_GITHUB_REPO=amillimatrix-eng/CARBON-Creation-Hub
AMX_GITHUB_REF=main
AMX_GITHUB_TOKEN=replace-with-read-token-at-runtime

# CARBON° media storage. Local fallback is prototype-only; configure an S3-compatible
# provider for durable listing/profile media without changing the listing URL contract.
CARBON_MEDIA_S3_BUCKET=
CARBON_MEDIA_PUBLIC_BASE_URL=
CARBON_MEDIA_S3_REGION=
CARBON_MEDIA_S3_ENDPOINT=
CARBON_MEDIA_S3_ACCESS_KEY=
CARBON_MEDIA_S3_SECRET_KEY=

# CARBON° external integrations deliberately remain provider slots:
# - payments implement backend.marketplace_money.MoneyAdapter
# - search / external marketplace feeds implement backend.marketplace_discovery.DiscoveryAdapter
# Provider credentials must be injected at runtime and are never committed here.
