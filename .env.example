# Optional write/admin control. If absent, write endpoints fail closed.
AMX_ADMIN_TOKEN=replace-with-runtime-secret

# Optional comma-separated browser origins. Same-origin House needs no CORS entry.
AMX_CORS_ORIGINS=

# Optional overrides. Defaults shown.
AMX_DB_PATH=/app/data/amx_evidence.db
AMX_REPO_ROOT=/app
